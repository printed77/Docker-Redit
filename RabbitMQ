七、設置docker-compose.yml(cd /opt/sre_tools/)
cd /opt/sre_tools/
sudo vi docker-compose.yml 安裝套件如下：
services:
  rabbitmq:
    image: rabbitmq:4.1.3-management
    restart: always
    container_name: ${cHostname}-rabbitmq
    
    # 保持 hostname 一致性
    hostname: ${cHostname}-rabbitmq
    
    ports:
      # 關鍵端口必須保留
      - "4369:4369"
      - "5672:5672"
      - "15672:15672"
      - "25672:25672"
      - "15692:15692"
      
    volumes:
      # 確保配置和資料持久化
      - /opt/rabbitmq/data:/var/lib/rabbitmq/
      - ./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf
      
    environment:
      # 預設使用者和密碼
      - RABBITMQ_DEFAULT_USER=admin
      - RABBITMQ_DEFAULT_PASS=5GzS4G3Sm8TlvZ52
      
      # 💥 關鍵修正 1：顯式設定 Short Node Name
      # 這是 Erlang 節點名稱，用於叢集，格式為 rabbit@hostname
      - RABBITMQ_NODENAME=rabbit@${cHostname}-rabbitmq 
      
      # 💥 關鍵修正 2：強制使用 Shortname 模式 (可選，但推薦)
      - RABBITMQ_USE_LONGNAME=false
      
    logging:
      driver: "gcplogs"
      
    deploy:
      resources:
        limits:
          cpus: '6.0'
          memory: 14G


