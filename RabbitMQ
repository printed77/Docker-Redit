五、執行 prepare-rabbitmq.sh
在此路徑：cd ~
sudo vi prepare-rabbitmq.sh

#!/bin/bash
# prepare-rabbitmq.sh - 在三台 VM 上執行

set -euo pipefail

ERLANG_COOKIE_SOURCE="${ERLANG_COOKIE:-@.erlang.cookie}"
RABBITMQ_DATA_DIR="/opt/rabbitmq/data"

# 1. 建立目錄
sudo mkdir -p ${RABBITMQ_DATA_DIR}

# 2. 解析 ERLANG_COOKIE 來源（支援 @file 或直接值）
if [[ "${ERLANG_COOKIE_SOURCE}" == @* ]]; then
  COOKIE_FILE="${ERLANG_COOKIE_SOURCE#@}"
  if [[ ! -f "${COOKIE_FILE}" ]]; then
    echo "Cookie source file not found: ${COOKIE_FILE}" >&2
    exit 1
  fi
  # 移除換行，確保內容正確
  ERLANG_COOKIE_VALUE="$(tr -d '\r\n' < "${COOKIE_FILE}")"
else
  ERLANG_COOKIE_VALUE="${ERLANG_COOKIE_SOURCE}"
fi

# 3. 寫入 .erlang.cookie
printf '%s' "${ERLANG_COOKIE_VALUE}" | sudo tee ${RABBITMQ_DATA_DIR}/.erlang.cookie > /dev/null

# 4. 設定權限（關鍵步驟）
sudo chmod 400 ${RABBITMQ_DATA_DIR}/.erlang.cookie
sudo chown 999:999 ${RABBITMQ_DATA_DIR}/.erlang.cookie

# 5. 驗證
echo "Cookie file created:"
sudo ls -la ${RABBITMQ_DATA_DIR}/.erlang.cookie

